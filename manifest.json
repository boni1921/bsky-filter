{
  "manifest_version": 3,
  "name": "Bsky Filter",
  "version": "1.2.2",
  "description": "Hide like, repost, and bookmark counts on Bluesky. Toggle each independently, or keep counts on your own posts. Renew expired mute words.",
  "permissions": ["storage"],
  "icons": {
    "128": "icon.png"
  },
  "host_permissions": [
    "https://bsky.app/*",
    "https://bsky.social/*",
    "https://*.host.bsky.network/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://bsky.app/*"],
      "js": ["content.js", "mute-words.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Bsky Filter",
    "default_popup": "popup.html",
    "default_icon": {
      "128": "icon.png"
    }
  }
}
